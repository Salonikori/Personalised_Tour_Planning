DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voyara?schema=public"
JWT_SECRET="trippilot-development-secret-2026"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
GROQ_API_KEY=
NUGEN_API_KEY=
# Set only after alignment has completed in Nugen; use its returned model_id.
NUGEN_ALIGNED_MODEL_ID=
# Optional override for the alignment setup script.
NUGEN_BASE_MODEL_ID=qwen-v2p5-0p5b-instruct
# For alignment creation, first upload, wait for READY, then rerun with returned IDs:
# NUGEN_DOCUMENT_IDS=document_id_1
# NUGEN_CREATE_ALIGNMENT=true

# Live travel data providers (spec: destination-aware discovery)
# Leave any of these blank to disable that provider; the pipeline degrades gracefully and
# reports UNAVAILABLE/DEMO status rather than inventing data.
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# When true, hotel/flight searches with no configured live provider return clearly-tagged demo data
# instead of an empty result. Never overrides a working live provider.
FALLBACK_CATALOG_MODE=true

# Checkout payment gateway (spec: real test-mode payment integration).
# Leave PAYMENT_PROVIDER blank (or set it to a provider whose keys are missing below) to keep using
# the built-in simulated payment flow - checkout still works with zero configuration.
# PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Automated no-key weather monitoring via Open-Meteo. Checks all trips inside Open-Meteo's
# 16-day forecast window on boot and then at this interval (minimum: 5 minutes).
WEATHER_CHECK_INTERVAL_MS=21600000

# Currency used for converted itinerary subtotals when a traveler has not set
# preferences.homeCurrency. Native inventory amounts always keep their currency:<ISO> tag.
HOME_CURRENCY=INR

