generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  OPERATOR
  VENDOR
  COORDINATOR
  ADMIN
}

enum ItemType {
  FLIGHT
  HOTEL
  ACTIVITY
  TRANSFER
}

enum ItemStatus {
  PLANNED
  CONFIRMED
  AT_RISK
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum RecoveryStatus {
  DRAFT
  PROPOSED
  TRAVELER_APPROVED
  APPROVED
  REJECTED
}

enum GroupParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
}

enum OpenSlotRequestStatus {
  OPEN
  AWARDED
  CLOSED
}

enum VendorBidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  supportPhone String?
  preferences  Json?
  currentLocation String?
  loyaltyPoints Int     @default(0)
  referralCode  String  @unique @default(cuid())
  vendorId     String?  @unique
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trips        Trip[]
  operatedGroups      TourGroup[]        @relation("GroupOperator")
  groupParticipations GroupParticipant[]
  coordinatedTrips      Trip[]      @relation("TripCoordinator")
  coordinatedTourGroups TourGroup[] @relation("TourGroupCoordinator")
  notifications         Notification[]
  activityVotes          ActivityVote[]
  sosAlerts              SosAlert[]
  openSlotRequests       OpenSlotRequest[]
  safetyReports          SafetyReport[]
}

model Trip {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  coordinatorId String?
  coordinator   User?         @relation("TripCoordinator", fields: [coordinatorId], references: [id])
  origin      String?
  destination String
  startDate   DateTime
  endDate     DateTime
  budget      Float
  travelerCount Int              @default(1)
  tripType    String             @default("leisure")
  categoryWeights Json?
  travelStyle String
  status      String
  approvalStatus String          @default("NOT_SUBMITTED")
  adminFeedback String?
  reviewedAt DateTime?
  reviewedById String?
  requestedPlaces Json?
  requestedActivities Json?
  requestedActivityDays Json?
  companyName String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       ItineraryItem[]
  disruptions Disruption[]
  reviews     Review[]
  safetyReports SafetyReport[]
  simulations Simulation[]
  tourGroups  TourGroup[]
  activityVotes ActivityVote[]
  sosAlerts     SosAlert[]
  openSlotRequests OpenSlotRequest[]
  checklistItems TripChecklistItem[]
  adjustments TripAdjustment[]
}

model TripAdjustment {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  reason    String
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}

model Simulation {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  input     Json
  result    Json
  appliedAt DateTime?
  createdAt DateTime  @default(now())
}

model Vendor {
  id               String          @id @default(cuid())
  name             String          @unique
  category         String
  availability     String
  priceRange       String
  reliabilityScore Int
  confirmationRate Float
  cancellationRate Float
  responseTime     Int
  items            ItineraryItem[]
  inventory        InventoryItem[]
  bookings         Booking[]
  reviews          Review[]
  user             User?
  bids             VendorBid[]
}

model InventoryItem {
  id             String          @id @default(cuid())
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type           ItemType
  title          String
  location       String
  price          Float
  availability   String
  tags           Json
  details        Json?
  source         String          @default("seed")
  bookable       Boolean         @default(true)
  itineraryItems ItineraryItem[]
  activityVotes ActivityVote[]
}

model ItineraryItem {
  id               String                @id @default(cuid())
  tripId           String
  trip             Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type             ItemType
  title            String
  startTime        DateTime
  endTime          DateTime
  location         String
  cost             Float
  vendorId         String?
  vendor           Vendor?               @relation(fields: [vendorId], references: [id])
  inventoryItemId  String?
  inventoryItem    InventoryItem?        @relation(fields: [inventoryItemId], references: [id])
  status           ItemStatus            @default(PLANNED)
  reasoning        String?
  preferenceScore  Float?
  booking          Booking?
  dependenciesFrom ItineraryDependency[] @relation("Predecessor")
  dependenciesTo   ItineraryDependency[] @relation("Dependent")
  disruptions      Disruption[]
  activityVotes    ActivityVote[]
  sosAlerts        SosAlert[]
}

model ItineraryDependency {
  id            String        @id @default(cuid())
  predecessorId String
  dependentId   String
  predecessor   ItineraryItem @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  dependent     ItineraryItem @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, dependentId])
}

model Booking {
  id                 String         @id @default(cuid())
  itineraryItemId    String         @unique
  itineraryItem      ItineraryItem  @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor         @relation(fields: [vendorId], references: [id])
  confirmationStatus BookingStatus
  paymentStatus      PaymentStatus
  amount             Float
  createdAt          DateTime       @default(now())
  paymentAudits      PaymentAudit[]
}

model PaymentAudit {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event     String
  amount    Float
  vendorId  String
  details   String?
  createdAt DateTime @default(now())
}

model Disruption {
  id             String             @id @default(cuid())
  tripId         String
  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  affectedItemId String
  affectedItem   ItineraryItem      @relation(fields: [affectedItemId], references: [id])
  type           String
  severity       String
  status         String
  details        String
  timestamp      DateTime           @default(now())
  plans          RecoveryPlan[]
  snapshot       ItinerarySnapshot?
}

model RecoveryPlan {
  id                String         @id @default(cuid())
  disruptionId      String
  disruption        Disruption     @relation(fields: [disruptionId], references: [id], onDelete: Cascade)
  changedItems      Json
  extraCost         Float
  timeDelta         Int
  preferenceScore   Float
  finalScore        Float
  explanation       String
  status            RecoveryStatus @default(DRAFT)
  vendorReliability Float          @default(0)
}

model ItinerarySnapshot {
  id           String     @id @default(cuid())
  disruptionId String     @unique
  disruption   Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)
  itinerary    Json
  bookings     Json
  createdAt    DateTime   @default(now())
}

model Review {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  rating    Int
  tags      Json
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, vendorId])
}

model TourGroup {
  id           String             @id @default(cuid())
  tripId       String
  trip         Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     User               @relation("GroupOperator", fields: [operatorId], references: [id])
  coordinatorId String?
  coordinator   User?             @relation("TourGroupCoordinator", fields: [coordinatorId], references: [id])
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants GroupParticipant[]
}

model GroupParticipant {
  id          String                 @id @default(cuid())
  tourGroupId String
  tourGroup   TourGroup              @relation(fields: [tourGroupId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  status      GroupParticipantStatus @default(INVITED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  shareWeight Float?

  @@unique([tourGroupId, userId])
}

model ActivityVote {
  id                  String         @id @default(cuid())
  tripId              String
  trip                Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItemId     String?
  itineraryItem       ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade)
  candidateInventoryId String?
  candidateInventory   InventoryItem? @relation(fields: [candidateInventoryId], references: [id], onDelete: Cascade)
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote                ActivityVoteChoice
  createdAt           DateTime       @default(now())

  @@index([tripId, itineraryItemId, candidateInventoryId])
  @@index([userId, itineraryItemId, candidateInventoryId])
}

enum ActivityVoteChoice {
  YES
  NO
}


model OpenSlotRequest {
  id          String                 @id @default(cuid())
  operatorId  String
  operator    User                   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  destination String
  category    ItemType
  dateNeeded  DateTime
  budgetCap   Float
  status      OpenSlotRequestStatus   @default(OPEN)
  createdAt   DateTime               @default(now())
  bids        VendorBid[]

  @@index([operatorId, status, createdAt])
  @@index([category, status, dateNeeded])
}

model VendorBid {
  id           String          @id @default(cuid())
  slotRequestId String
  slotRequest  OpenSlotRequest @relation(fields: [slotRequestId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  price        Float
  notes        String?
  status       VendorBidStatus @default(PENDING)
  createdAt    DateTime        @default(now())

  @@index([slotRequestId, status, createdAt])
  @@index([vendorId, status, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

// Platform-wide admin console settings. Single row keyed by a fixed id ("singleton") -
// additive only, does not affect any existing traveler/operator/vendor/coordinator flow.
model PlatformSettings {
  id                String   @id @default("singleton")
  platformName      String   @default("Voyara")
  supportEmail      String   @default("support@voyara.demo")
  maintenanceMode   Boolean  @default(false)
  bookingFeePercent Float    @default(2.5)
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  tripId    String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model FxRate {
  id           String   @id @default(cuid())
  baseCurrency String
  quoteCurrency String
  rate         Float
  asOf         DateTime
  fetchedAt    DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, asOf])
}


enum ChecklistCategory {
  DOCUMENT
  PACKING
  REMINDER
}

enum ChecklistItemSource {
  AUTO
  MANUAL
}

model TripChecklistItem {
  id        String              @id @default(cuid())
  tripId    String
  trip      Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category  ChecklistCategory
  label     String
  isDone    Boolean             @default(false)
  source    ChecklistItemSource @default(AUTO)
  createdAt DateTime            @default(now())

  @@index([tripId, category, createdAt])
}

enum SosAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SosAlert {
  id              String         @id @default(cuid())
  tripId          String
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryItemId String?
  itineraryItem   ItineraryItem?  @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  lat             Float?
  lng             Float?
  message         String?
  status          SosAlertStatus  @default(OPEN)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  @@index([tripId, status, createdAt])
}

model SafetyZone {
  id            String   @id @default(cuid())
  zoneKey       String   @unique
  centerLat     Float
  centerLng     Float
  reportCount   Int      @default(0)
  aiStatus      String   @default("SAFE")
  aiReason      String?
  aiConfidence  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reports       SafetyReport[]

  @@index([aiStatus, updatedAt])
}

model SafetyReport {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?       @relation(fields: [tripId], references: [id], onDelete: SetNull)
  zoneId      String
  zone        SafetyZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  message     String?
  category    String      @default("SAFETY_CONCERN")
  createdAt   DateTime    @default(now())

  @@index([zoneId, createdAt])
}
